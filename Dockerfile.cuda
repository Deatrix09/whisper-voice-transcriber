# SPDX-License-Identifier: Apache-2.0
# P0 0.5: GPU image pro transkripci bez lokálního Pythonu.
# Vyžaduje host s NVIDIA driverem (CUDA 12.x, pro torch cu12 kola) + nvidia-container-toolkit.
FROM nvidia/cuda:12.1.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/root/.cache/huggingface

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg python3.11 python3.11-venv curl ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && ffmpeg -version | head -n 1

# uv pro reprodukovatelný sync ze zamčených verzí
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app
# Nejdřív manifesty (cache vrstva), pak zbytek kódu (.dockerignore hlídá).
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project

COPY main.py run_comparison.py run_multiple_configs.py ./
COPY src/ ./src/
COPY algorithm/ ./algorithm/
COPY config/ ./config/

# .env se NEMOUNTUJE do image (viz compose volumes) - token jen za běhu.
RUN mkdir -p data/input data/output logs

HEALTHCHECK --interval=60s --timeout=30s --start-period=120s --retries=2 \
    CMD /app/.venv/bin/python -c "import torch; print(torch.cuda.is_available())"

ENTRYPOINT ["/app/.venv/bin/python", "main.py"]
# Příklad: docker compose run --rm transcriber --input data/input/example.mp3 --format txt
